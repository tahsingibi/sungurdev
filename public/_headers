# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Optimised /_next/image responses inherit "immutable" from their source image.
# Without it the image handler sent no Cache-Control at all, so every view
# re-ran an Images transformation. Never overwrite a file here: add a new name.
/images/*
  Cache-Control: public,max-age=31536000,immutable
